{
    "name": "sol2uml-light",
    "version": "0.1.1",
    "type": "commonjs",
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@12.18.0",
    "description": "A lightweight Solidity contract visualisation tool based on sol2uml.",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "scripts": {
        "buildSol": "cd ./src/contracts && solc **/*.sol",
        "build": "pnpm run clean && tsc --build --force ./tsconfig.json",
        "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
        "lint": "eslint src/ts --ignore-pattern '**/__tests__/**'",
        "permit": "node -e \"require('node:fs').chmodSync('lib/sol2uml.js', 0o775)\"",
        "prettier": "prettier --write src/**/*.ts **/*.md",
        "prettier:check": "prettier --check src/**/*.ts  **/*.md",
        "test": "jest --runInBand",
        "test:release": "node --test scripts/__tests__/release.test.cjs",
        "test:integration": "jest --runInBand --testRegex '/__tests__/.*\\.integration\\.test\\.ts$'",
        "test:libraries": "jest --runInBand --runTestsByPath src/ts/__tests__/currentLibraries.test.ts",
        "prepack": "pnpm run build && pnpm run permit",
        "release": "node scripts/release.cjs",
        "test:solidity": "jest --runInBand --runTestsByPath src/ts/__tests__/modernSolidity.test.ts",
        "examples:build": "pnpm run build && node scripts/generate-examples.cjs"
    },
    "preferGlobal": true,
    "contributors": [
        "whackur"
    ],
    "license": "MIT",
    "dependencies": {
        "@aduh95/viz.js": "^3.7.0",
        "@noble/hashes": "^1.8.0",
        "@resvg/resvg-js": "^2.6.2",
        "@solidity-parser/parser": "^0.20.2",
        "cli-color": "^2.0.4",
        "commander": "^12.1.0",
        "debug": "^4.4.1",
        "diff-match-patch": "^1.0.5",
        "js-graph-algorithms": "^1.0.18",
        "klaw": "^4.1.0"
    },
    "devDependencies": {
        "@account-abstraction/contracts": "0.8.0",
        "@eslint/js": "^10.0.1",
        "@openzeppelin/contracts": "5.6.1",
        "@types/diff-match-patch": "^1.0.36",
        "@types/jest": "^30.0.0",
        "@types/klaw": "^3.0.8",
        "@types/node": "^24.19.2",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "jest": "^30.5.2",
        "prettier": "^3.9.10",
        "solc": "0.8.38",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "files": [
        "lib/**/*.js",
        "lib/**/*.d.ts"
    ],
    "bin": {
        "sol2uml-light": "lib/sol2uml.js"
    },
    "keywords": [
        "Unified Modeling Language",
        "UML",
        "Solidity",
        "Ethereum",
        "diagram",
        "class",
        "contract",
        "Blockchain",
        "storage",
        "flatten",
        "visual",
        "tool",
        "cli"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/whackur/sol2uml-ligth.git"
    },
    "homepage": "https://github.com/whackur/sol2uml-ligth#readme",
    "bugs": {
        "url": "https://github.com/whackur/sol2uml-ligth/issues"
    }
}
